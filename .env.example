# Porta HTTP local. A hospedagem geralmente já fornece PORT.
PORT=3000

# Use production na hospedagem (exige PostgreSQL e acesso HTTPS).
NODE_ENV=development

# PostgreSQL em produção. Use a URL do provedor com sslmode=require.
# Deixe vazio em desenvolvimento para usar o SQLite local.
DATABASE_URL=

# Gere um valor aleatório de pelo menos 32 caracteres. Veja o README.txt.
SESSION_SECRET=

# Credenciais do primeiro administrador. Preencha antes de rodar npm run seed.
ADMIN_EMAIL=
# 12 caracteres no mínimo e até 72 bytes em UTF-8.
ADMIN_SENHA=

# Contato público (opcional). O WhatsApp deve conter DDI, DDD e número.
CONTATO_EMAIL=
CONTATO_WHATSAPP=

# Código IBGE do município consultado no InfoDengue.
GEOCODE_MUNICIPIO=2928604

# Quantidade de proxies confiáveis até a aplicação. Padrão: 0 local, 1 em produção.
# TRUST_PROXY=1
